Options -Indexes
DirectoryIndex index.html
RewriteEngine On
RewriteRule ^(?:\.git|\.codex|\.agents|database|test|scripts)(?:/|$) - [F,L]
RewriteRule ^backend/(?!index\.php$) - [F,L]
RewriteRule ^api(?:/(.*))?$ backend/index.php?route=$1 [QSA,L]
<FilesMatch "(^\.|\.sql$|\.log$|\.local\.php$|^server\.js$|^package.*\.json$)">
 Require all denied
</FilesMatch>
